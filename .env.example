# Copy to .env (ignored). Replace every REPLACE value before starting.
APP_PORT=18080
POSTGRES_DB=plantclassifier
POSTGRES_USER=plantclassifier
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_PASSWORD
POSTGRES_PORT=5433
# For a native JVM: export these values, or configure them in IntelliJ.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/plantclassifier
SPRING_DATASOURCE_USERNAME=plantclassifier
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_PASSWORD
DEVICE_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Set true when the browser accesses the application over HTTPS.
SESSION_COOKIE_SECURE=false
# Actual ESP32 addresses reachable from the host AND the Docker container.
# Separate sensor and movement boards. The simulation overlay supplies two software URLs.
ESP32_URL=http://192.0.2.10
MOVEMENT_ESP32_URL=http://192.0.2.11
ML_PYTHON_PATH=python3
ML_SCRIPT_PATH=predict.py
ML_WORKING_DIRECTORY=MLClassification
ML_TIMEOUT=30s
ESP32_CONNECT_TIMEOUT=2s
ESP32_READ_TIMEOUT=5s
MOVEMENT_CONNECT_TIMEOUT=300ms
MOVEMENT_READ_TIMEOUT=500ms
SENSOR_TEMPERATURE_MIN=-40
SENSOR_TEMPERATURE_MAX=85
